{
  "name": "hotelsystem_mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "set NODE_OPTIONS=--max-old-space-size=16384&& node --max-old-space-size=16384 node_modules/expo/bin/cli start --max-workers 1",
    "android": "set NODE_OPTIONS=--max-old-space-size=16384&& node --max-old-space-size=16384 node_modules/expo/bin/cli start --android --max-workers 1",
    "android:clear": "set NODE_OPTIONS=--max-old-space-size=16384&& node --max-old-space-size=16384 node_modules/expo/bin/cli start --android --max-workers 1 --clear",
    "ios": "set NODE_OPTIONS=--max-old-space-size=16384&& node --max-old-space-size=16384 node_modules/expo/bin/cli start --ios --max-workers 1",
    "web": "set NODE_OPTIONS=--max-old-space-size=16384&& node --max-old-space-size=16384 node_modules/expo/bin/cli start --web --max-workers 1",
    "export:android": "set NODE_OPTIONS=--max-old-space-size=16384&& node --max-old-space-size=16384 node_modules/expo/bin/cli export --platform android --clear --max-workers 1",
    "debug:node": "node -e \"console.log({ node: process.version, platform: process.platform, arch: process.arch, execArgv: process.execArgv, NODE_OPTIONS: process.env.NODE_OPTIONS });\""
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
